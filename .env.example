# Copy this file to .env and fill in your key.

# --- Online brain (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Check the current model IDs at https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-4-5
MAX_TOKENS=1024

# --- Offline brain (optional local model via Ollama) ---
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Storage: SQLite keeps everything on your laptop (works offline) ---
DATABASE_URL=sqlite:///./pa.db
# DATABASE_URL=postgresql+psycopg://pa:pa@localhost:5432/pa

# --- About you ---
ASSISTANT_NAME=Ava
USER_NAME=Betty
TIMEZONE=Africa/Nairobi

# --- Behaviour ---
ONBOARDING_DAYS=10
AFFIRMATION_HOUR=6
AFFIRMATION_BANK_DAYS=7
HISTORY_LIMIT=20
